class_name Shipyard
extends RefCounted
## The shipyard build path of `docs/gameplay/10_ship_acquisition.md` section 3, as data
## plus one queue. Contract: section 3.1 (the hull recipes and their labour), section 3.2
## (the module shape rule -- "2x its tier's component family + 12x a matching-tier ore +
## 20 % of list as labour"; "the shape rule is the contract so the coder cannot invent
## prices"), section 3.3 (one build at a time, one in-space session, committed at queue,
## full refund on cancel before completion, persists, and the scrap path at 50 % of the
## recipe materials round down).
##
## Prices are **never** hand-picked here: a hull's materials are section 3.1's own rows
## and a module's are the shape rule's, and every CR figure re-derives from the live
## 02 ore values (`MineralCatalog`, the 2026-10-08 block) and 03 component values
## (`ComponentCatalog`). `materials_value` is the one reader of those tables.
##
## Pure data + API: no nodes, no scene tree. The queue's own store lives in
## `PlayerProfile` (the `shipyard` save key); `game/shipyard.gd` is its only production
## caller, exactly as `game/refinery.gd` owns the refinery store.

const MineralData := preload("res://game/mineral_catalog.gd")
const ComponentData := preload("res://game/component_catalog.gd")
const ModuleData := preload("res://game/module_catalog.gd")

## 10 section 3.1's hull recipes, verbatim: one row per 08 section 2 class, keyed by the
## ship id whose list price the doc's "vs list" column matches. `materials` is the raw
## ore/component bill (the shipyard buys from miners, not refiners) and `labour` is the
## doc's credit fee.
const HULL_RECIPES: Dictionary = {
	&"ship_fighter": {
		&"materials": {&"mineral_iron": 45, &"mineral_chromium": 25, &"comp_scrap_1": 2},
		&"labour": 3150,
	},
	&"ship_vanguard": {
		&"materials": {&"mineral_titanium": 55, &"mineral_aluminium": 30, &"comp_mech_1": 3},
		&"labour": 6300,
	},
	&"ship_miner": {
		&"materials": {&"mineral_titanium": 50, &"mineral_silver": 35, &"comp_mech_1": 4},
		&"labour": 5600,
	},
	&"ship_trader": {
		&"materials": {&"mineral_titanium": 55, &"mineral_copper": 30, &"comp_mech_1": 3},
		&"labour": 7350,
	},
	&"ship_corvette": {
		&"materials": {&"mineral_tungsten": 60, &"mineral_cobalt": 35, &"comp_scrap_2": 4},
		&"labour": 9450,
	},
	&"ship_freighter": {
		&"materials": {&"mineral_titanium": 70, &"mineral_iron": 50, &"comp_scrap_2": 5},
		&"labour": 8400,
	},
	&"ship_gunship": {
		&"materials": {&"mineral_tungsten": 70, &"mineral_neodymium": 35, &"comp_weap_1": 6},
		&"labour": 12600,
	},
	&"ship_patrol": {
		&"materials": {&"mineral_iridium": 45, &"mineral_platinum": 25, &"comp_mech_2": 8},
		&"labour": 18900,
	},
	&"ship_destroyer": {
		&"materials": {&"mineral_osmium": 70, &"mineral_gold": 40, &"comp_scrap_3": 12},
		&"labour": 25200,
	},
}

## 10 section 3.2's shape rule: 2x the tier's component family + 12x a matching-tier ore
## + 20 % of list as labour.
const COMPONENT_UNITS := 2
const ORE_UNITS := 12
const LABOUR_SHARE := 0.20
## 10 section 3.3's scrap path: 50 % of the recipe materials, round down.
const SCRAP_SHARE := 0.5

## The build kinds a queue record names.
const KIND_HULL: StringName = &"hull"
const KIND_MODULE: StringName = &"module"

## 03 section 3's family per 09 section 1 slot type ("Used for"), in the catalogue's
## own family ids (`weap`/`ore_grade`/`salvage`/`elec`/`mech`/`pow`): weapons -> gun
## parts, shields -> refined exotic matter (shield lattice), armour -> hull scrap,
## computers -> electronics, engines/utility -> machinery, boosters/power -> power.
const FAMILY_BY_SLOT: Dictionary = {
	&"weapons": &"weap",
	&"shields": &"ore_grade",
	&"armour": &"salvage",
	&"computers": &"elec",
	&"engines": &"mech",
	&"utility": &"mech",
	&"boosters": &"pow",
	&"power": &"pow",
}

## The job record's keys.
const KEY_KIND: StringName = &"kind"
const KEY_ID: StringName = &"id"
const KEY_MATERIALS: StringName = &"materials"
const KEY_LABOUR: StringName = &"labour"
const KEY_SESSION: StringName = &"session"


## 10 section 3.1's recipe for one hull, a copy, or `{}` for a hull the table does not
## carry. The materials are the doc's own rows and the labour its own fee.
static func hull_recipe(ship_id: StringName) -> Dictionary:
	var row: Variant = HULL_RECIPES.get(ship_id, null)
	if not row is Dictionary:
		return {}
	return (row as Dictionary).duplicate(true)


## 10 section 3.2's recipe for one module, generated by the shape rule: `2 x` the
## module's tier component family, `12 x` a matching-tier ore, and `20 %` of the
## module's own 09 list price as labour. `{}` for an id the catalogue does not carry.
static func module_recipe(base_id: StringName) -> Dictionary:
	var row := ModuleData.module(base_id)
	if row.is_empty():
		return {}
	var materials: Dictionary = {}
	var component := component_id(base_id)
	if component != &"":
		materials[component] = COMPONENT_UNITS
	var ore := ore_id(int(row.get(&"tier", 1)))
	if ore != &"":
		materials[ore] = ORE_UNITS
	var labour := roundi(float(int(row.get(&"cost", 0))) * LABOUR_SHARE)
	return {KEY_MATERIALS: materials, KEY_LABOUR: labour}


## The recipe a build kind names, or `{}` for an unknown kind or id.
static func recipe_for(kind: StringName, id: StringName) -> Dictionary:
	if kind == KIND_HULL:
		return hull_recipe(id)
	if kind == KIND_MODULE:
		return module_recipe(id)
	return {}


## The 03 component id one module builds from: its slot's family at its tier's grade
## (capped at the catalogue's three grades), or `&""` for an unknown id.
static func component_id(base_id: StringName) -> StringName:
	var row := ModuleData.module(base_id)
	if row.is_empty():
		return &""
	var family := StringName(FAMILY_BY_SLOT.get(ModuleData.fit_slot_of(base_id), &""))
	if family == &"":
		return &""
	var grade := clampi(int(row.get(&"tier", 1)), 1, 3)
	for entry: Dictionary in ComponentData.family_components(family):
		if int(entry.get(&"grade", 0)) == grade:
			return StringName(entry.get(&"id", &""))
	return &""


## The 02 ore a module at `tier` builds from: the tier's own first mineral in its raw
## form (iron/titanium/gold/palladium), or `&""` for a tier the catalogue does not carry.
static func ore_id(tier: int) -> StringName:
	var rows := MineralData.tier_minerals(tier)
	if rows.is_empty():
		return &""
	return MineralData.ore_id(StringName(rows[0].get(&"id", &"")))


## The live CR value of one material unit: the 03 component `value`, or the 02 ore's
## `ore_value`, 0 for anything else. Never a restated price.
static func item_value(item_id: StringName) -> int:
	var component := ComponentData.component(item_id)
	if not component.is_empty():
		return int(component.get(&"value", 0))
	if MineralData.is_ore(item_id):
		return int(MineralData.entry_for_item(item_id).get(&"ore_value", 0))
	return 0


## The live CR value of a materials bill, summed over the live catalogue values.
static func materials_value(materials: Dictionary) -> int:
	var total := 0
	for key: Variant in materials:
		total += item_value(StringName(str(key))) * int(materials[key])
	return total


## A recipe's CR total: its materials at live values plus its labour fee.
static func recipe_total(recipe: Dictionary) -> int:
	if recipe.is_empty():
		return 0
	return materials_value(recipe.get(KEY_MATERIALS, {})) + int(recipe.get(KEY_LABOUR, 0))


## 10 section 3.3's scrap yield: 50 % of a recipe's materials, round down, one entry per
## material that yields at least one unit.
static func scrap_materials(materials: Dictionary) -> Dictionary:
	var out: Dictionary = {}
	for key: Variant in materials:
		var units := int(floor(float(int(materials[key])) * SCRAP_SHARE))
		if units > 0:
			out[key] = units
	return out


## Every hull the yard can build, in `HULL_RECIPES`' own order.
static func buildable_hulls() -> Array[StringName]:
	var ids: Array[StringName] = []
	for id: Variant in HULL_RECIPES:
		ids.append(StringName(str(id)))
	return ids


## Every module the yard can build: the base catalogue plus the S27 variant rows, less
## the 15 section 5 exclusives (they live at faction stations, 15 section 5).
static func buildable_modules() -> Array[StringName]:
	var ids: Array[StringName] = []
	for id: Variant in ModuleData.MODULES:
		var key := StringName(str(id))
		if ModuleData.EXCLUSIVES.has(key):
			continue
		ids.append(key)
	ids.append_array(ModuleData.variant_ids())
	return ids


## The active job, or `{}`. A read of the profile's own store.
static func job(profile) -> Dictionary:
	if profile == null:
		return {}
	return profile.shipyard_job()


## Whether the active job is complete: the profile has flown a session since the queue
## (10 section 3.3: "ready when you return from your next flight").
static func is_ready(profile, record: Dictionary = {}) -> bool:
	var active := record if not record.is_empty() else job(profile)
	if active.is_empty() or profile == null:
		return false
	return profile.shipyard_session() > int(active.get(KEY_SESSION, 0))


## Queue one build (10 section 3.3): refuses while a job is active ("one build at a
## time"), when the profile cannot pay the labour, or when the hold lacks any material.
## On success the materials leave the hold and the labour leaves the credits -- both
## **committed at queue time**.
static func queue_job(profile, kind: StringName, id: StringName) -> bool:
	if profile == null or not job(profile).is_empty():
		return false
	var recipe := recipe_for(kind, id)
	if recipe.is_empty():
		return false
	var materials: Dictionary = recipe.get(KEY_MATERIALS, {})
	for key: Variant in materials:
		if profile.cargo_qty(StringName(str(key))) < int(materials[key]):
			return false
	var labour := int(recipe.get(KEY_LABOUR, 0))
	if not profile.can_afford(labour):
		return false
	for key: Variant in materials:
		profile.remove_cargo(StringName(str(key)), int(materials[key]))
	profile.spend(labour)
	profile.set_shipyard_job({
		KEY_KIND: kind,
		KEY_ID: id,
		KEY_MATERIALS: materials,
		KEY_LABOUR: labour,
		KEY_SESSION: profile.shipyard_session(),
	})
	return true


## Cancel the active job before completion (10 section 3.3): refunds the materials to
## the hold and the labour to the credits, **in full**. Refuses once the job is ready
## ("after completion ... no refunds").
static func cancel_job(profile) -> bool:
	var active := job(profile)
	if active.is_empty() or is_ready(profile, active):
		return false
	var materials: Dictionary = active.get(KEY_MATERIALS, {})
	for key: Variant in materials:
		profile.add_cargo(StringName(str(key)), int(materials[key]))
	profile.add_credits(int(active.get(KEY_LABOUR, 0)))
	profile.set_shipyard_job({})
	return true


## Collect a ready job (10 section 3.3): the hull is delivered to the owned list, or the
## module (15 section 2's shipyard source: always Common, no affixes) into the bag, and
## the queue clears.
static func collect(profile) -> bool:
	var active := job(profile)
	if active.is_empty() or not is_ready(profile, active):
		return false
	var kind := StringName(str(active.get(KEY_KIND, &"")))
	var id := StringName(str(active.get(KEY_ID, &"")))
	if kind == KIND_HULL:
		if not profile.grant_ship(id):
			return false
	elif kind == KIND_MODULE:
		profile.add_module(id, 1)
	else:
		return false
	profile.set_shipyard_job({})
	return true


## 10 section 3.3's play gate: one in-space session. `game.gd` calls this at launch;
## the queue reads the counter, never real-world time.
static func note_flight(profile) -> void:
	if profile == null:
		return
	profile.set_shipyard_session(profile.shipyard_session() + 1)
